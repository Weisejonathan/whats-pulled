DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Runtime: Supabase transaction pooler (port 6543). Tools: direct/session pooler (5432).
DATABASE_DIRECT_URL=""
# Provider CA in PEM format (literal \n supported); keeps TLS hostname verification enabled.
DATABASE_SSL_CA=""
# Local transfer only; never point preview deployments at production.
TARGET_DATABASE_DIRECT_URL=""
ADMIN_ACCESS_CODE="change-this-admin-code"
AUTH_SECRET="generate-a-long-random-secret"
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4.1-mini"
# Admin dashboard estimates. Prices are USD per 1M tokens and can be updated without code changes.
OPENAI_INPUT_COST_PER_MILLION="0.40"
OPENAI_OUTPUT_COST_PER_MILLION="1.60"
MONTHLY_TOOL_BUDGET_USD="50"
BLOB_READ_WRITE_TOKEN=""
# Default r2. vercel-blob is only a temporary detector rollout fallback.
MEDIA_STORAGE_PROVIDER="r2"
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BUCKET="whats-pulled-images"
R2_PRIVATE_BUCKET="whats-pulled-private"
# Custom domain on the PUBLIC bucket only. Do not use r2.dev for production.
R2_PUBLIC_URL="https://images.YOUR_DOMAIN"
# Exact existing public Blob hosts, comma separated; used only for migration.
LEGACY_BLOB_HOSTS=""
SPORTRADAR_API_KEY="your-sportradar-tennis-api-key"
SPORTRADAR_ACCESS_LEVEL="trial"
SPORTRADAR_LANGUAGE="en"
